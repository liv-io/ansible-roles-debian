	stage.match {
		selector = "{app=\"grafana\"}"

		stage.regex {
			expression = "logger=(?P<logger>[^ ]*) t=(?P<time>[^ ]*) level=(?P<level>[^ ]*) msg=\"(?P<msg>[^\"]*)\" duration=(?P<duration>[^ ]*)"
		}

		stage.regex {
			expression = "logger=(?P<logger>[^ ]*) t=(?P<time>[^ ]*) level=(?P<level>[^ ]*) msg=\"(?P<msg>[^\"]*)\" error=(?P<error>[^ ]*) traceID=(?P<traceID>[^ ]*)"
		}

		stage.regex {
			expression = "logger=(?P<logger>[^ ]*) t=(?P<time>[^ ]*) level=(?P<level>[^ ]*) msg=\"(?P<msg>[^\"]*)\" error=(?P<error>[^ ]*) duration=(?P<duration>[^ ]*)"
		}

		stage.labels {
			values = {
				level = null,
			}
		}

		stage.match {
			selector = "{level=\"critical\"}"

			stage.static_labels {
				values = {
					severity_normalized = "critical",
				}
			}
		}

		stage.match {
			selector = "{level=\"error\"}"

			stage.static_labels {
				values = {
					severity_normalized = "error",
				}
			}
		}

		stage.match {
			selector = "{level=\"warning\"}"

			stage.static_labels {
				values = {
					severity_normalized = "warning",
				}
			}
		}

		stage.match {
			selector = "{level=\"info\"}"

			stage.static_labels {
				values = {
					severity_normalized = "info",
				}
			}
		}

		stage.match {
			selector = "{level=\"debug\"}"

			stage.static_labels {
				values = {
					severity_normalized = "info",
				}
			}
		}

		stage.output {
			source = "msg"
		}
	}
