	stage.label_keep {
		values = [
			"app",
			"host",
			"job",
			"level",
			"severity_normalized",
		]
	}
}

discovery.relabel "syslog" {
	targets = []

	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__syslog_message_hostname"]
		target_label  = "host"
	}
}

loki.relabel "clean" {
	forward_to = [loki.process.syslog.receiver]

	rule {
		action = "labeldrop"
		regex  = "^(service_name|service-name|facility|severity)$"
	}
}

loki.source.syslog "syslog" {
	listener {
		address               = "0.0.0.0:1514"
		protocol              = "tcp"
		idle_timeout          = "1m0s"
		label_structured_data = false
		labels                = {
			job = "syslog",
		}

		max_message_length = 0
	}
	forward_to    = [loki.relabel.clean.receiver]
	relabel_rules = discovery.relabel.syslog.rules
}

loki.write "default" {
	endpoint {
		url       = "http://localhost:3100/loki/api/v1/push"
		tenant_id = "tenant1"
	}
	external_labels = {}
}
